# Copy to .env and fill keys. Never commit .env.
# Agnes (free flash only: agnes-3.0-flash / agnes-2.5-flash)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

# Zhipu GLM (free flash only: glm-4-flash / glm-4-flash-250414)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Live / heartbeat
SOCIETY_MAX_EXCHANGES=20
SOCIETY_MAX_TICKS=0
SOCIETY_TICK_MS=2000
SOCIETY_COOLDOWN_MS=600
SOCIETY_AGENT_COOLDOWN_MS=400
SOCIETY_IDLE_STALE_MS=8000
SOCIETY_DAILY_LLM_BUDGET=80
# SOCIETY_SEED_LINE=广场开机了。

# Observe UI (Docker compose overrides host to 0.0.0.0)
SOCIETY_OBSERVE_HOST=127.0.0.1
SOCIETY_OBSERVE_PORT=8787
# Set to 1 in Docker so browser→published port can POST /api/say
SOCIETY_OBSERVE_ALLOW_REMOTE_SAY=0

# Sandbox: bwrap on Linux host; docker inside containers (no nested bwrap)
SOCIETY_SANDBOX_MODE=bwrap

# Optional caps
# SOCIETY_MAX_AGENTS=8

# Memory LLM consolidate
# SOCIETY_WORKING_MAX=20
# SOCIETY_CONSOLIDATE_COOLDOWN_MS=300000
